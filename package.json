{
  "name": "agentcargo-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-agent registry and package manager for reusable AI-agent skills.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "check": "pnpm --recursive check",
    "test": "pnpm build && pnpm --recursive test",
    "verify": "pnpm check && pnpm test",
    "check:migrations": "node scripts/check-migrations.mjs --strict",
    "test:migrations": "node --test scripts/check-migrations.test.mjs",
    "check:beta": "pnpm check:migrations && node scripts/check-beta-readiness.mjs --strict",
    "test:beta": "pnpm test:migrations && node --test scripts/check-beta-readiness.test.mjs",
    "dev:cli": "pnpm build && node packages/cli/dist/index.js",
    "release:cli": "pnpm build && node scripts/release-cli.mjs"
  }
}
